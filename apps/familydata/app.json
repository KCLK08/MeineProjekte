{
  "expo": {
    "name": "Family Vault",
    "slug": "familydata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/FamilyVault.png",
    "scheme": "familydata",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "splash": {
      "image": "./assets/images/FamilyVault.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.meineprojekte.familydata",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Family Vault nutzt biometrische Freigabe nur auf diesem Gerät, um den Zugriff zu schützen.",
        "NSCameraUsageDescription": "Kamera für lokale Dokumentfotos und zum Scannen von Pairing-QR-Codes bei der Geräteübertragung.",
        "NSPhotoLibraryUsageDescription": "Galerie nur zum Anhängen eigener Dokumentfotos (lokal).",
        "NSLocalNetworkUsageDescription": "Lokales Netzwerk nur für die verschlüsselte Geräte-zu-Gerät-Übertragung im gleichen WLAN.",
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDisplayName": "Family Vault"
      }
    },
    "android": {
      "package": "de.meineprojekte.familydata",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/FamilyVault.png",
        "backgroundColor": "#fafafb"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "./plugins/withAndroidHardening.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Family Vault nutzt Face ID zum Entsperren auf diesem Gerät."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galeriezugriff nur für lokale Dokumentfotos.",
          "cameraPermission": "Kamerazugriff nur für lokale Dokumentfotos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera zum Scannen von Pairing-QR-Codes bei der Geräteübertragung.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-4000-8000-000000000001"
      }
    }
  }
}
