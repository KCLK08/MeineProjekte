{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@meineprojekte/theme": ["packages/theme/src"],
      "@meineprojekte/ui": ["packages/ui/src"],
      "@meineprojekte/utils": ["packages/utils/src"],
      "@meineprojekte/types": ["packages/types/src"],
      "@meineprojekte/hooks": ["packages/hooks/src"],
      "@meineprojekte/catalog": ["packages/catalog/src"]
    }
  }
}
