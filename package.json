{
  "name": "meineprojekte",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo f\u00fcr Expo/React-Native Apps und Shared Packages",
  "workspaces": [
    "apps/bautagebuch",
    "apps/buew-toolbox",
    "apps/ds-datenbank",
    "apps/elifba",
    "packages/*",
    "website"
  ],
  "scripts": {
    "start:bautagebuch": "npm run start -w @meineprojekte/bautagebuch",
    "start:buew-toolbox": "npm run start -w @meineprojekte/buew-toolbox",
    "start:ds-datenbank": "npm run start -w @meineprojekte/ds-datenbank",
    "start:elifba": "npm run start -w @meineprojekte/elifba",
    "web:buew-toolbox": "npm run build:web -w @meineprojekte/buew-toolbox",
    "web:ds-datenbank": "npm run build:web -w @meineprojekte/ds-datenbank",
    "web:elifba": "npm run build:web -w @meineprojekte/elifba",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
