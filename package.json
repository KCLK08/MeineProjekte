{
  "name": "meineprojekte",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo – jedes Projekt separat starten, bauen und deployen",
  "scripts": {
    "install:all": "npm run install:bautagebuch && npm run install:buew-toolbox && npm run install:ds-datenbank && npm run install:elifba",
    "install:bautagebuch": "npm install --prefix apps/bautagebuch",
    "install:buew-toolbox": "npm install --prefix apps/buew-toolbox && npm install --prefix apps/buew-toolbox/sitereport && npm install --prefix apps/buew-toolbox/bautagebuch-v2",
    "install:ds-datenbank": "npm install --prefix apps/ds-datenbank",
    "install:elifba": "npm install --prefix apps/elifba",

    "dev:bautagebuch": "npm start --prefix apps/bautagebuch",
    "dev:buew-toolbox": "npm run dev --prefix apps/buew-toolbox",
    "dev:sitereport": "npm run dev --prefix apps/buew-toolbox/sitereport",
    "dev:bautagebuch-web": "npm run dev --prefix apps/buew-toolbox/bautagebuch-v2",
    "dev:ds-datenbank": "npm run dev --prefix apps/ds-datenbank",
    "dev:elifba": "npm start --prefix apps/elifba",

    "build:buew-toolbox": "npm run build --prefix apps/buew-toolbox",
    "build:sitereport": "npm run build --prefix apps/buew-toolbox/sitereport",
    "build:bautagebuch-web": "npm run build --prefix apps/buew-toolbox/bautagebuch-v2",
    "build:ds-datenbank": "npm run build --prefix apps/ds-datenbank",
    "build:elifba": "npm run build --prefix apps/elifba",

    "deploy:buew-toolbox": "npm run deploy --prefix apps/buew-toolbox",
    "deploy:ds-datenbank": "npm run deploy --prefix apps/ds-datenbank",
    "deploy:elifba": "npm run deploy --prefix apps/elifba"
  },
  "engines": {
    "node": ">=20"
  }
}
